# Copy to .env at the repository root. Both Node and Vite read this file.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
ROOM_CAPACITY=8
MATCH_SECONDS=180
SERVE_CLIENT=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# Empty uses the local Vite proxy or combined server. Render requires a backend URL.
VITE_SERVER_URL=
# Render backend: NODE_ENV=production, SERVE_CLIENT=false; Render supplies PORT.
# ALLOWED_ORIGINS=https://YOUR-FRONTEND.onrender.com
# Render static frontend: VITE_SERVER_URL=https://YOUR-BACKEND.onrender.com
