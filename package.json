{
  "name": "crossfire-karts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch --env-file-if-exists=.env server/src/index.ts\" \"vite --config client/vite.config.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server/src/index.js",
    "start:server": "node --env-file-if-exists=.env dist/server/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:production": "node scripts/production-smoke.mjs",
    "check": "npm run build && npm test && npm run test:browser && npm run test:production",
    "benchmark": "tsx scripts/benchmark.ts",
    "review:visuals": "tsx scripts/capture-map.ts --visual-upgrade",
    "profile:rendering": "tsx scripts/profile-rendering.ts"
  },
  "engines": { "node": ">=24.18.0 <25" },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
